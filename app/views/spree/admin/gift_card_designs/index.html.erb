<% admin_breadcrumb(link_to(t('spree.listing_gift_cards'), spree.admin_gift_cards_path)) %>
<% admin_breadcrumb(t('spree.admin.gift_card_designs.title')) %>

<% content_for :page_actions do %>
  <ul class="actions inline-menu">
    <li><%= link_to t('spree.admin.gift_card_designs.new'), new_object_url, class: 'btn btn-primary' %></li>
  </ul>
<% end %>

<p><%= t('spree.admin.gift_card_designs.explanation') %></p>

<% if @collection.any? %>
  <table class="index">
    <thead>
      <tr>
        <th><%= t('spree.admin.gift_card_designs.preview') %></th>
        <th><%= Spree::GiftCardDesign.human_attribute_name(:name) %></th>
        <th><%= Spree::GiftCardDesign.human_attribute_name(:active) %></th>
        <th><%= Spree::GiftCardDesign.human_attribute_name(:position) %></th>
        <th class="actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @collection.each do |design| %>
        <tr id="<%= spree_dom_id design %>">
          <td><%= link_to image_tag(preview_admin_gift_card_design_path(design), alt: design.name, width: 240, loading: 'lazy'), edit_object_url(design) %></td>
          <td><%= link_to design.name, edit_object_url(design) %></td>
          <td>
            <span class="pill pill-<%= design.active? ? 'active' : 'inactive' %>"><%= t(design.active? ? :active : :inactive, scope: 'spree') %></span>
          </td>
          <td><%= design.position %></td>
          <td class="actions">
            <%= link_to_edit design, no_text: true %>
            <%= link_to_delete design, no_text: true if design.virtual_gift_cards.none? %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="no-objects-found"><%= t('spree.admin.gift_card_designs.none') %></div>
<% end %>
