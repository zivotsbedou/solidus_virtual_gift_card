<% admin_breadcrumb(link_to(t('spree.admin.gift_card_designs.title'), spree.admin_gift_card_designs_path)) %>
<% admin_breadcrumb(@object.name) %>

<%= render 'spree/shared/error_messages', target: @object %>
<%= form_for [:admin, @object], html: { multipart: true, id: 'gift_card_design_form' } do |f| %>
  <fieldset>
    <%= render 'form', f: f %>
    <%= f.hidden_field :layout, value: @object.layout&.to_json %>
    <%= render 'spree/admin/shared/edit_resource_links' %>
  </fieldset>
<% end %>
<fieldset>
  <legend><%= t('spree.admin.gift_card_designs.preview') %></legend>
  <div id="gift_card_design_canvas" style="position: relative; display: inline-block; max-width: 100%; user-select: none;">
    <%= image_tag preview_admin_gift_card_design_path(@object, v: @object.updated_at.to_i), id: 'gift_card_design_preview', alt: t('spree.admin.gift_card_designs.preview'), draggable: false, style: 'display: block; max-width: 100%; height: auto;' %>
    <% @object.card_layout.each do |field, style| %>
      <div data-field="<%= field %>" data-x="<%= style[:x] %>" data-y="<%= style[:y] %>" data-width="<%= style[:width] %>"
           data-size="<%= style[:size] %>" data-align="<%= style.fetch(:align, :low) %>"
           <%= 'data-qr' if field.to_sym == :qr %>
           style="position: absolute; box-sizing: border-box; border: 1px dashed #e11d48; background: rgba(225, 29, 72, 0.08); cursor: move; touch-action: none;">
        <span style="position: absolute; left: 0; bottom: 100%; padding: 0 3px; font-size: 10px; line-height: 14px; white-space: nowrap; color: #fff; background: #e11d48;"><%= t(field, scope: 'spree.admin.gift_card_designs.fields', default: field.to_s.humanize) %></span>
        <span data-handle style="position: absolute; right: -6px; bottom: -6px; width: 12px; height: 12px; background: #e11d48; cursor: nwse-resize;"></span>
      </div>
    <% end %>
  </div>
  <p><button type="button" id="gift_card_design_reset_layout" class="btn btn-default"><%= t('spree.admin.gift_card_designs.reset_layout') %></button></p>
</fieldset>

<script>
  (() => {
    const form = document.getElementById('gift_card_design_form')
    const preview = document.getElementById('gift_card_design_preview')
    const canvas = document.getElementById('gift_card_design_canvas')
    const layoutField = form.elements['gift_card_design[layout]']
    const layout = JSON.parse(layoutField.value || '{}')
    const fields = ['amount_color', 'ink_color', 'box_color', 'layout']
    const lineHeight = 1.25 // a text frame shows one line of its font size
    let timer

    // Redraw the preview from the unsaved form.
    const refresh = () => {
      const params = new URLSearchParams()
      fields.forEach((field) => params.set(`gift_card_design[${field}]`, form.elements[`gift_card_design[${field}]`].value))
      preview.src = `<%= preview_admin_gift_card_design_path(@object) %>?${params}`
    }

    // Frames use the card's own fractions: x and width of its width, y and size of its height.
    const ratio = () => (preview.naturalHeight / preview.naturalWidth) || (1240 / 1748)
    const place = (box) => {
      const { x, y, size } = box.dataset
      const width = 'qr' in box.dataset ? size * ratio() : Number(box.dataset.width)
      const left = box.dataset.align === 'centre' ? x - width / 2 : x
      Object.assign(box.style, {
        left: `${left * 100}%`, top: `${y * 100}%`, width: `${width * 100}%`,
        height: `${size * ('qr' in box.dataset ? 1 : lineHeight) * 100}%`
      })
    }
    const boxes = canvas.querySelectorAll('[data-field]')
    boxes.forEach(place)
    preview.addEventListener('load', () => boxes.forEach(place), { once: true })

    const round = (value, min = 0) => Math.min(1, Math.max(min, Math.round(value * 1000) / 1000))
    canvas.addEventListener('pointerdown', (event) => {
      const box = event.target.closest('[data-field]')
      if (!box) return
      event.preventDefault()
      const resize = 'handle' in event.target.dataset
      const rect = canvas.getBoundingClientRect()
      const start = { px: event.clientX, py: event.clientY, x: +box.dataset.x, y: +box.dataset.y, width: +box.dataset.width, size: +box.dataset.size }
      const move = (moved) => {
        const dx = (moved.clientX - start.px) / rect.width
        const dy = (moved.clientY - start.py) / rect.height
        if (!resize) {
          box.dataset.x = round(start.x + dx)
          box.dataset.y = round(start.y + dy)
        } else if ('qr' in box.dataset) {
          box.dataset.size = round(start.size + dy, 0.02)
        } else {
          box.dataset.width = round(start.width + dx * (box.dataset.align === 'centre' ? 2 : 1), 0.02)
          box.dataset.size = round(start.size + dy / lineHeight, 0.005)
        }
        place(box)
      }
      const drop = () => {
        window.removeEventListener('pointermove', move)
        const { x, y, width, size } = box.dataset
        layout[box.dataset.field] = 'qr' in box.dataset ? { x: +x, y: +y, size: +size } : { x: +x, y: +y, width: +width, size: +size }
        layoutField.value = JSON.stringify(layout)
        refresh()
      }
      window.addEventListener('pointermove', move)
      window.addEventListener('pointerup', drop, { once: true })
    })

    form.addEventListener('input', (event) => {
      if (event.target.type === 'file') return
      clearTimeout(timer)
      timer = setTimeout(refresh, 400)
    })

    document.getElementById('gift_card_design_reset_layout').addEventListener('click', () => {
      layoutField.value = ''
      form.requestSubmit()
    })
  })()
</script>
